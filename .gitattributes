*.sh text eol=lf
*.exe binary

# cursor/scripts/clover-hook.cmd is the single hooks.json entry point on every
# platform: a cmd/sh polyglot whose first line is a label to cmd.exe and an exec
# trampoline to a POSIX shell. cmd.exe needs CRLF (it misparses LF-only batch
# files), and the shell tolerates it because that first line ends in a comment
# that swallows the CR.
*.cmd text eol=crlf
