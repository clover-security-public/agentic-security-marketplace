{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/claude/scripts/setup.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/claude/scripts/run-hook.sh check-update",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/claude/scripts/run-hook.sh review-plan",
            "timeout": 300
          }
        ]
      },
      {
          "matcher": "Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "bash ${CLAUDE_PLUGIN_ROOT}/claude/scripts/run-hook.sh should-review-plan",
              "timeout": 300
            }
          ]
        }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/claude/scripts/run-hook.sh log-prompt",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
