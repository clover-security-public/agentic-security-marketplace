{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/codex/scripts/run-hook.sh\" codex-check-update",
            "shell": "bash",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/codex/scripts/run-hook.sh\" codex-should-review-plan",
            "shell": "bash",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/codex/scripts/run-hook.sh\" codex-review-plan",
            "shell": "bash",
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/codex/scripts/run-hook.sh\" codex-log-prompt",
            "shell": "bash",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
