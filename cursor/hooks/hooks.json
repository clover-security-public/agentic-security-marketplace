{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/cursor/scripts/setup.sh\""
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/cursor/scripts/run-hook.sh\" log-prompt"
      }
    ],
    "stop": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/cursor/scripts/run-hook.sh\" review-plan-stop",
        "timeout": 300,
        "loop_limit": 3
      }
    ]
  }
}
