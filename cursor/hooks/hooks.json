{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/cursor/scripts/clover-hook\" cursor-setup"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/cursor/scripts/clover-hook\" cursor-log-prompt"
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/cursor/scripts/clover-hook\" cursor-review-plan-stop",
        "timeout": 300,
        "loop_limit": 3
      }
    ]
  }
}
