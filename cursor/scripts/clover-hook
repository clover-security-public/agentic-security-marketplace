#!/bin/sh
# Unix half of the Cursor hook launcher.
#
# Cursor's hooks.json allows exactly one `command` string per hook entry, with no
# per-OS variant (the operatingSystems filter exists only for dashboard-managed
# team hooks). Both platforms therefore have to be reachable through one path, so
# hooks.json points at this extensionless name and each platform's shell picks
# its own half:
#
#   macOS / Linux  Cursor runs the command with a POSIX shell, which matches this
#                  file exactly and execs the matching prebuilt binary.
#   Windows        Cursor runs the command with PowerShell, whose command lookup
#                  appends the PATHEXT extensions to a path-qualified command and
#                  so resolves the sibling clover-hook.cmd. This file is never
#                  read there — which is the entire point. Naming a .sh in
#                  hooks.json is what made Windows spawn Git Bash: PowerShell
#                  hands a .sh to the shell association, and `bash` resolves to
#                  Git Bash's console bash.exe, which pops a window.
#
# All real work lives in the binary's cursor-* subcommands; this only selects the
# executable and forwards arguments. Keep argument handling identical to
# clover-hook.cmd: both pass "$@" through untouched.

set -u

ROOT="${CURSOR_PLUGIN_ROOT:-}"
if [ -z "$ROOT" ]; then
    # scripts live at <root>/cursor/scripts/, so the root is two levels up.
    ROOT="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd)" || ROOT=""
fi

OS="$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m 2>/dev/null)"
case "$OS" in
    darwin*) OS=darwin ;;
    linux*) OS=linux ;;
esac
case "$ARCH" in
    x86_64 | amd64) ARCH=amd64 ;;
    aarch64 | arm64) ARCH=arm64 ;;
esac

BIN="${ROOT}/bin/clover-hook-${OS}-${ARCH}"

# Zip and tarball extraction both drop the executable bit; restore it rather
# than failing the hook.
if [ ! -x "$BIN" ] && [ -f "$BIN" ]; then
    chmod +x "$BIN" 2>/dev/null || true
fi

if [ ! -x "$BIN" ]; then
    # Fail open: Clover must never stand between a developer and their agent.
    # stderr is surfaced in Cursor's hook log for diagnosis; stdout carries the
    # per-hook safe default so the turn proceeds. sessionStart and the stop hook
    # both treat empty stdout as "no opinion", so they print nothing.
    echo "clover: hook binary not found at ${BIN}" >&2
    case "${1:-}" in
        cursor-log-prompt) printf '{"continue":true}\n' ;;
        cursor-review-plan) printf '{"permission":"allow"}\n' ;;
    esac
    exit 0
fi

exec "$BIN" "$@"
