{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" setup"
        },
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" check-update",
          "timeout": 90
        },
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" session-baseline",
          "timeout": 30
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" log-prompt"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" snapshot-working-tree",
          "timeout": 30
        }
      ]
    },
    {
      "matcher": "write|edit|apply_patch|write_plan|exec",
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" review-write",
          "timeout": 300
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" review-exec",
          "timeout": 300
        }
      ]
    },
    {
      "matcher": "write|edit|apply_patch|notebook_edit|exec",
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" mark-session-edit",
          "timeout": 30
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLOVER_DEVIN_ROOT:-${DEVIN_PLUGIN_ROOT}/devin}/scripts/clover-hook.cmd\" stop-implementation-review",
          "timeout": 120
        }
      ]
    }
  ]
}
